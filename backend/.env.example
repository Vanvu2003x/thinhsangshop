# Server Configuration
NODE_ENV=development
PORT=5000
SOCKET_PORT=5001

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=gamerechargedb

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT Configuration (MUST be 64+ random characters in production!)
JWT_SECRET_KEY=your_super_secret_key_123456

# External Services
RESEND_API_KEY=re_12345678_example_key
TOKEN_WEB2M=your_web2m_token_hash
NAPGAME247_API_KEY=your_napgame247_api_key

# Callback Security (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CALLBACK_SECRET=your_callback_secret_for_webhook_verification

# CORS & Socket Origins
# Production: https://thinhsangshop.vn,https://www.thinhsangshop.vn
CORS_ORIGINS=http://localhost:3000
SOCKET_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Styles
LOGO=https://example.com/logo.png

# Gmail SMTP
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=support@thinhsangshop.vn
SMTP_PASS=your_smtp_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
